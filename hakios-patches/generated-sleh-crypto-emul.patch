+#include <arm64/coreprime_crypto_emul.h>
+
+/*
+ * Core Prime: the MSM8916 Cortex-A53 has no Crypto Extension (ID_AA64ISAR0_EL1
+ * AES/SHA1/SHA2 = 0) but Apple arm64 userland uses it unconditionally. Execute
+ * those EL0 instructions in software on the saved V registers (spilled to the
+ * PCB on exception entry and reloaded on return), then step over them.
+ */
+static uint64_t coreprime_crypto_emulated;
+
+static bool
+coreprime_emulate_user_crypto(arm_saved_state_t *state, uint32_t instr)
+{
+	arm_neon_saved_state_t *ns = get_user_neon_regs(current_thread());
+
+	if (ns == NULL || !is_neon_saved_state64(ns) ||
+	    !coreprime_crypto_emulate(instr, (cp_v128 *)neon_state64(ns)->v.q)) {
+		return false;
+	}
+	if (os_atomic_inc_orig(&coreprime_crypto_emulated, relaxed) == 0) {
+		printf("crypto-emul: first EL0 crypto instruction 0x%08x at pc=0x%llx emulated\n",
+		    instr, get_saved_state_pc(state));
+	}
+	add_saved_state_pc(state, 4);
+	return true;
+}
+
