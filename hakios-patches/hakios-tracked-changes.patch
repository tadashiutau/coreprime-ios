+static void
+sd_init(void)
+{
+ DTEntry entry;const void *type;unsigned size;
+ uint64_t sectors=0;
+ if(SecureDTLookupEntry(NULL,"/arm-io",&entry)!=kSuccess ||
+    SecureDTGetProperty(entry,"device_type",&type,&size)!=kSuccess ||
+    size!=8 || memcmp(type,"msm8916",8)!=0) {
+  printf("sdmmc: refusing non-MSM8916 device tree\n");return;
+ }
+ /* Explicit bound from the current card's MBR; do not invent its capacity. */
+ if(!PE_parse_boot_argn("sdmmc_sectors",&sectors,sizeof(sectors)) ||
+    !sectors || sectors>0xffffffffULL){printf("sdmmc: missing valid sector bound\n");return;}
+ PE_parse_boot_argn("sdmmc_start",&blk_sd_start,sizeof(blk_sd_start));
+ if(blk_sd_start>0xffffffffULL || sectors>0x100000000ULL-blk_sd_start)return;
+ struct blk_device *d=&blk_dev;
+ d->regs=ml_io_map(0x07864900,0x1000);d->capacity=sectors;
+ if(!(reg_read(d,0x28)&0x100) || !(reg_read(d,0x2c)&4)) {
+  printf("sdmmc: slot 2 not powered/clocked by bootloader\n");return;
+ }
+ reg_write(d,0x38,0);reg_write(d,0x34,0xffffffff);
+ uint8_t sector[512];
+ if(sd_sector(d,(uint32_t)blk_sd_start,sector)){printf("sdmmc: initial sector read failed\n");return;}
+ uint64_t hash=14695981039346656037ULL;
+ for(unsigned i=0;i<512;i++){hash^=sector[i];hash*=1099511628211ULL;}
+ printf("sdmmc: slot 2 view LBA0 FNV %llx, MBR %02x%02x\n",hash,sector[510],sector[511]);
+ printf("sdmmc: host control 0x%02x (4-bit bus %s), clock control 0x%04x, host version 0x%04x\n",
+  reg_read(d,0x28)&0xff,(reg_read(d,0x28)&2)?"yes":"no",reg_read(d,0x2c)&0xffff,reg_read(d,0xfc)>>16);
+ {
+  /* the same 2 MB both ways: speeds, and that the data agree */
+  uint8_t *buf=(uint8_t *)kalloc_data(BLK_MAX_XFER,Z_WAITOK);
+  if(buf) {
+   uint64_t h1=14695981039346656037ULL,h2=h1,t0,t1,t2;int e1=0,e2=0;
+   t0=mach_absolute_time();
+   for(uint32_t c=0;c<32&&!e1;c++)for(uint32_t k=0;k<128&&!e1;k++){
+    e1=sd_sector(d,(uint32_t)blk_sd_start+c*128+k,buf+512*k);
+    for(unsigned i=0;i<512;i++){h1^=buf[512*k+i];h1*=1099511628211ULL;}}
+   t1=mach_absolute_time();
+   for(uint32_t c=0;c<32&&!e2;c++){
+    e2=sd_sectors(d,(uint32_t)blk_sd_start+c*128,128,buf);
+    for(unsigned i=0;i<BLK_MAX_XFER&&!e2;i++){h2^=buf[i];h2*=1099511628211ULL;}}
+   t2=mach_absolute_time();
+   uint64_t ns1,ns2;absolutetime_to_nanoseconds(t1-t0,&ns1);absolutetime_to_nanoseconds(t2-t1,&ns2);
+   printf("sdmmc: 2 MB by single sectors %llu ms (err %d, FNV %llx); by 64 KB multi-block %llu ms (err %d, FNV %llx): %s\n",
+    ns1/1000000,e1,h1,ns2/1000000,e2,h2,(!e1&&!e2&&h1==h2)?"same data":"MISMATCH or error: multi-block off");
+   if(e2||e1||h1!=h2){blk_sd_multi=false;if(e2)sd_abort(d);}
