+/* Experimental retained-state MSM8916 microSD backend. The bootloader must
+ * leave slot 2 selected and powered. Read-only PIO, single outstanding request;
+ * no media write/erase commands, DMA, IRQ ownership, or power-management support.
+ * Shares this file's BSD block-device glue with virtio, not its transport. */
+static int
+sd_wait(struct blk_device *d, uint32_t off, uint32_t mask, uint32_t want)
+{
+ uint64_t deadline;clock_interval_to_deadline(1,NSEC_PER_SEC,&deadline);
+ while((reg_read(d,off)&mask)!=want) {
+  if(mach_absolute_time()>deadline)return EIO;
+  delay(1);
+ }
+ return 0;
+}
+static void sd_write16(struct blk_device *d,uint32_t off,uint16_t value)
+{
+ *(volatile uint16_t *)(d->regs+off)=value;__builtin_arm_dmb(0xb);
+}
+static int
+sd_sector(struct blk_device *d,uint32_t lba,uint8_t *dst)
+{
+ if(sd_wait(d,0x24,3,0))return EIO;
+ *(volatile uint8_t *)(d->regs+0x2e)=0xe;
+ reg_write(d,0x30,0xffffffff);
+ sd_write16(d,4,512);sd_write16(d,6,1);
+ reg_write(d,8,lba);sd_write16(d,0xc,0x10);sd_write16(d,0xe,0x113a);
+ uint64_t deadline;uint32_t status;
+ clock_interval_to_deadline(1,NSEC_PER_SEC,&deadline);
+ do {
+  status=reg_read(d,0x30);
+  if(status&0xffff8000)return EIO;
+  if(mach_absolute_time()>deadline)return EIO;
+ }while(!(status&0x20));
+ for(unsigned i=0;i<128;i++){uint32_t value=reg_read(d,0x20);bcopy(&value,dst+4*i,4);}
+ reg_write(d,0x30,0x20);
+ if(sd_wait(d,0x30,2,2))return EIO;
+ reg_write(d,0x30,0xffffffff);
+ return 0;
+}
+/*
+ * Several sectors with one CMD18 (READ_MULTIPLE_BLOCK): block count enabled, the controller
+ * itself sends CMD12 after the last block (auto CMD12), PIO through the buffer port, one block
+ * per buffer-read-ready. Card access latency is paid once per request instead of per sector.
+ */
+static bool blk_sd_multi = true;        /* off for good after the first multi-block failure */
+static int
+sd_sectors(struct blk_device *d,uint32_t lba,uint32_t count,uint8_t *dst)
+{
+ if(count==1)return sd_sector(d,lba,dst);
+ if(sd_wait(d,0x24,3,0))return EIO;
+ *(volatile uint8_t *)(d->regs+0x2e)=0xe;
+ reg_write(d,0x30,0xffffffff);
+ sd_write16(d,4,512);sd_write16(d,6,(uint16_t)count);
+ reg_write(d,8,lba);sd_write16(d,0xc,0x36);sd_write16(d,0xe,0x123a);
+ uint64_t deadline;uint32_t status;
+ for(uint32_t b=0;b<count;b++) {
+  clock_interval_to_deadline(1,NSEC_PER_SEC,&deadline);
+  do {
+   status=reg_read(d,0x30);
+   if(status&0xffff8000)return EIO;
+   if(mach_absolute_time()>deadline)return EIO;
+  }while(!(status&0x20));
+  reg_write(d,0x30,0x20);
+  uint32_t *out=(uint32_t *)(void *)(dst+512*b);
+  for(unsigned i=0;i<128;i++){uint32_t value=reg_read(d,0x20);bcopy(&value,out+i,4);}
+ }
+ if(sd_wait(d,0x30,2,2))return EIO;
+ status=reg_read(d,0x30);
+ reg_write(d,0x30,0xffffffff);
+ return (status&0xffff8000)?EIO:0;
+}
+/* After a failed multi-block read: reset the command and data lines, stop the card's transfer (CMD12, R1b). */
+static void
+sd_abort(struct blk_device *d)
+{
+ *(volatile uint8_t *)(d->regs+0x2f)=0x06;__builtin_arm_dmb(0xb);
+ (void)sd_wait(d,0x2f,0x06,0);
+ reg_write(d,0x30,0xffffffff);
+ if(sd_wait(d,0x24,1,0)==0){reg_write(d,8,0);sd_write16(d,0xc,0);sd_write16(d,0xe,0x0cdb);
+  (void)sd_wait(d,0x30,1,1);(void)sd_wait(d,0x24,2,0);}
+ reg_write(d,0x30,0xffffffff);
+}
+static int
+sd_io(struct blk_device *d,bool write,uint64_t offset,void *data,size_t len)
+{
+ if(write)return EROFS;
+ if((offset&511)||(len&511)||len>BLK_MAX_XFER || offset/512>d->capacity ||
+    len/512>d->capacity-offset/512)return EINVAL;
+ int error=0;lck_mtx_lock(&d->lock);
+ if(!blk_ready)error=ENXIO;
+ uint32_t lba=(uint32_t)(blk_sd_start+offset/512);
+ if(!error && blk_sd_multi && len>512) {
+  error=sd_sectors(d,lba,(uint32_t)(len/512),(uint8_t*)data);
+  if(error) {
+   printf("sdmmc: multi-block read at byte %llu failed; single sectors from now on\n",offset);
+   blk_sd_multi=false;sd_abort(d);error=0;
+  } else {
+   lck_mtx_unlock(&d->lock);return 0;
+  }
+ }
+ for(size_t done=0;!error&&done<len;done+=512)
+  error=sd_sector(d,(uint32_t)(blk_sd_start+(offset+done)/512),(uint8_t*)data+done);
+ if(error){blk_ready=false;printf("sdmmc: read failed at byte %llu; device disabled\n",offset);}
+ lck_mtx_unlock(&d->lock);return error;
+}
