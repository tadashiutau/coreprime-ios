 	return true;
 }
 
+static void
+sd_init(void)
+{
+ DTEntry entry;const void *type;unsigned size;
+ uint64_t sectors=0;
+ if(SecureDTLookupEntry(NULL,"/arm-io",&entry)!=kSuccess ||
+    SecureDTGetProperty(entry,"device_type",&type,&size)!=kSuccess ||
+    size!=8 || memcmp(type,"msm8916",8)!=0) {
+  printf("sdmmc: refusing non-MSM8916 device tree\n");return;
+ }
+ /* Explicit bound from the current card's MBR; do not invent its capacity. */
+ if(!PE_parse_boot_argn("sdmmc_sectors",&sectors,sizeof(sectors)) ||
+    !sectors || sectors>0xffffffffULL){printf("sdmmc: missing valid sector bound\n");return;}
+ PE_parse_boot_argn("sdmmc_start",&blk_sd_start,sizeof(blk_sd_start));
+ if(blk_sd_start>0xffffffffULL || sectors>0x100000000ULL-blk_sd_start)return;
+ struct blk_device *d=&blk_dev;
+ d->regs=ml_io_map(0x07864900,0x1000);d->capacity=sectors;
+ if(!(reg_read(d,0x28)&0x100) || !(reg_read(d,0x2c)&4)) {
+  printf("sdmmc: slot 2 not powered/clocked by bootloader\n");return;
+ }
+ reg_write(d,0x38,0);reg_write(d,0x34,0xffffffff);
+ uint8_t sector[512];
+ if(sd_sector(d,(uint32_t)blk_sd_start,sector)){printf("sdmmc: initial sector read failed\n");return;}
+ uint64_t hash=14695981039346656037ULL;
+ for(unsigned i=0;i<512;i++){hash^=sector[i];hash*=1099511628211ULL;}
+ printf("sdmmc: slot 2 view LBA0 FNV %llx, MBR %02x%02x\n",hash,sector[510],sector[511]);
+ lck_mtx_init(&d->lock,&blk_lck_grp,LCK_ATTR_NULL);
+ blk_bmajor=bdevsw_add(-1,&blk_bdevsw);
+ if(blk_bmajor<0)return;
+ blk_cmajor=cdevsw_add_with_bdev(-1,&blk_cdevsw,blk_bmajor);
+ if(blk_cmajor<0)return;
+ if(!devfs_make_node(makedev(blk_bmajor,0),DEVFS_BLOCK,UID_ROOT,GID_OPERATOR,0600,"sdblk0") ||
+    !devfs_make_node(makedev(blk_cmajor,0),DEVFS_CHAR,UID_ROOT,GID_OPERATOR,0600,"rsdblk0"))return;
+ blk_sdmmc=true;blk_writable=false;blk_ready=true;
+ printf("sdmmc: /dev/sdblk0 and /dev/rsdblk0, %llu sectors, read only\n",sectors);
+}
