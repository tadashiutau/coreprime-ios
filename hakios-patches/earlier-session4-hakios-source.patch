+   int error=blk_io(&blk_dev,false,(uint64_t)off&~511ULL,sector,512);
+   if(error)return error;
+   unsigned within=(unsigned)off&511;
+   int amount=(int)MIN((uint64_t)uio_resid(uio),512-within);
+   if((error=uiomove((char*)sector+within,amount,uio)))return error;
+  }
+  return 0;
+ }
+ /* virtio's existing buffered path */
 	return physio(blk_dev_strategy, NULL, dev, B_READ, (u_int (*)(buf_t))blk_dev_size,
 	    uio, VIRTIO_BLK_SECTOR);
 }
