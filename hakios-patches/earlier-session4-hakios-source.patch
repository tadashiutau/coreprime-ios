-	/* the character device is here so that tools can see the disk; reads go by buffer */
+	/* physio can expose a user VA directly in buf_map(); PIO must never write it.
+  * Stage raw SD reads in kernel memory and let uiomove handle the user copy. */
+ if(blk_sdmmc) {
+  uint8_t sector[512];
+  while(uio_resid(uio)>0) {
